# Google Cloud project ID linked to your Dialogflow ES agent
DIALOGFLOW_PROJECT_ID=your-gcp-project-id

# Path to service account JSON (local development)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Optional — production: base64-encoded service account JSON (use instead of GOOGLE_APPLICATION_CREDENTIALS)
# GOOGLE_CREDENTIALS_BASE64=

# Optional — defaults shown
PORT=3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Production only — Socket.io CORS origin
# NEXT_PUBLIC_APP_URL=https://your-domain.com
